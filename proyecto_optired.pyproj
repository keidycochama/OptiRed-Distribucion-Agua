<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{FCD219B6-3086-41B1-995B-65C31EF05AC8}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <ProjectTypeGuids>{888888a0-9f3d-457c-b088-3a5042f75d52}</ProjectTypeGuids>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <IsWindowsApplication>False</IsWindowsApplication>
    <Name>proyecto_optired</Name>
    <RootNamespace>proyecto_optired</RootNamespace>
    <!-- Al abrir el proyecto en Visual Studio 2022 (workload "Python development"),
         VS pedira que selecciones el interprete de Python instalado en tu equipo. -->
